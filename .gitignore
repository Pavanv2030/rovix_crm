#-------------------------
# Secrets — NEVER commit
#-------------------------
.env
.env.*
!.env.example

#-------------------------
# Runtime / generated
#-------------------------
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
writable/uploads/*
writable/debugbar/*
writable/temp/*

#-------------------------
# Dependencies
#-------------------------
/vendor/
/node_modules/

#-------------------------
# Tooling / OS
#-------------------------
.php-cs-fixer.cache
.phpunit.cache
phpunit.xml
/build/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
